{{#> layouts/base title="Welcome to Gravitest!" subject="Welcome to Gravitest! Start Your Learning Journey"}}
  
  <p style="font-size: 15px; color: #4b5563; line-height: 1.6; margin: 0 0 16px;">
    Welcome to Gravitest! We're excited to help you achieve your academic goals.
  </p>

  <div style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-radius: 16px; padding: 20px; margin: 20px 0; text-align: center;">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="1.5" style="display: block; margin: 0 auto 12px;">
      <path d="M12 2L2 7l10 5 10-5-10-5z"/>
      <path d="M2 17l10 5 10-5"/>
      <path d="M2 12l10 5 10-5"/>
    </svg>
    <p style="font-size: 14px; font-weight: 600; color: #166534; margin: 0;">Your learning journey begins now</p>
  </div>

  <p style="font-size: 14px; color: #4b5563; margin: 16px 0 8px;"><strong>What's waiting for you:</strong></p>
  <ul style="margin: 8px 0 0 20px; padding: 0;">
    <li style="font-size: 13px; color: #4b5563; margin: 6px 0;">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" style="display: inline; vertical-align: middle; margin-right: 6px;">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      Practice exams for JAMB, WAEC, NECO
    </li>
    <li style="font-size: 13px; color: #4b5563; margin: 6px 0;">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" style="display: inline; vertical-align: middle; margin-right: 6px;">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      AI tutor for instant explanations
    </li>
    <li style="font-size: 13px; color: #4b5563; margin: 6px 0;">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" style="display: inline; vertical-align: middle; margin-right: 6px;">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      1-on-1 tutoring sessions
    </li>
    <li style="font-size: 13px; color: #4b5563; margin: 6px 0;">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" style="display: inline; vertical-align: middle; margin-right: 6px;">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
      Educational games and achievements
    </li>
  </ul>

  {{> action-button buttonText="Start Learning" buttonUrl=dashboardUrl}}

{{/layouts/base}}