{{#> layouts/base title="Session revoked" subject="A session has been revoked — Gravitest"}}

  <p style="font-size: 15px; color: #3a3832; line-height: 1.7; margin: 0 0 8px;">
    A session on one of your devices has been revoked from your Gravitest account.
  </p>

  {{#if deviceName}}
  <table width="100%" cellpadding="0" cellspacing="0" role="presentation"
    style="background-color: #f7f6f2; border: 1px solid #e0ddd6; border-radius: 4px; margin: 20px 0;">
    <tr>
      <td style="padding: 14px 20px;">
        <table cellpadding="0" cellspacing="0" role="presentation">
          <tr>
            <td style="font-size: 12px; color: #9e9b94; padding: 0; width: 110px;">Revoked device</td>
            <td style="font-size: 13px; color: #2c2a26; font-weight: 500; padding: 0;">{{deviceName}}</td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
  {{/if}}

  {{> action-button buttonText="Manage sessions" buttonUrl=sessionsUrl}}

{{/layouts/base}}
