{{#> layouts/base title="Password Changed" subject="Your Password Has Been Changed - Gravitest"}}
  
  <p style="font-size: 15px; color: #4b5563; line-height: 1.6; margin: 0 0 16px;">
    Your Gravitest account password was successfully changed.
  </p>

  {{> security-alert 
      alertMessage="This change was made from the following device:" 
      deviceName=deviceName 
      browser=browser 
      ipAddress=ipAddress 
      time=time}}

  {{#if infoMessage}}
    {{> info-alert message="If you didn't make this change, please reset your password immediately and contact our support team." type="error"}}
  {{/if}}

  {{> action-button buttonText="Review Account Security" buttonUrl=securityUrl}}

{{/layouts/base}}