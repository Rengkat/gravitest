{{#> layouts/base title="Verify your email address" subject="Please verify your email address — Gravitest"}}

  <p style="font-size: 15px; color: #3a3832; line-height: 1.7; margin: 0 0 8px;">
    Please verify your email address to activate your Gravitest account.
  </p>
  <p style="font-size: 14px; color: #6b6861; line-height: 1.7; margin: 0 0 4px;">
    Enter the code below on the verification screen, or click the button to verify directly.
  </p>

  {{> otp-card otpCode=otpCode expiryMinutes=expiryMinutes}}

  {{> action-button buttonText="Verify email address" buttonUrl=verificationUrl}}

  <p style="font-size: 13px; color: #9e9b94; margin: 24px 0 0; line-height: 1.6;">
    If you did not create a Gravitest account, you can safely ignore this email.
  </p>

{{/layouts/base}}
