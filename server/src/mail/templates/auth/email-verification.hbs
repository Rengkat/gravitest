{{#> layouts/base title="Verify Your Email" subject="Verify Your Email Address - Gravitest"}}
  
  <p style="font-size: 15px; color: #4b5563; line-height: 1.6; margin: 0 0 16px;">
    Thanks for joining Gravitest! Please verify your email address to activate your account and start your learning journey.
  </p>

  {{> otp-card otpCode=otpCode expiryMinutes=expiryMinutes}}

  <p style="font-size: 13px; color: #6b7280; line-height: 1.5; margin: 16px 0 0;">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="1.5" style="display: inline; vertical-align: middle; margin-right: 4px;">
      <circle cx="12" cy="12" r="10"/>
      <line x1="12" y1="8" x2="12" y2="12"/>
      <line x1="12" y1="16" x2="12.01" y2="16"/>
    </svg>
    The verification link will expire in <strong>{{expiryMinutes}} minutes</strong>. If you didn't create an account with Gravitest, you can safely ignore this email.
  </p>

  {{> action-button buttonText="Verify Email Address" buttonUrl=verificationUrl}}

{{/layouts/base}}