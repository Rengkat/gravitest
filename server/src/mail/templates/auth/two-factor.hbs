{{#> layouts/base title="Two-Factor Authentication" subject="Your Two-Factor Authentication Code - Gravitest"}}
  
  <p style="font-size: 15px; color: #4b5563; line-height: 1.6; margin: 0 0 16px;">
    Use the code below to complete your Two-Factor Authentication login.
  </p>

  {{> otp-card otpCode=otpCode expiryMinutes=expiryMinutes}}

  {{> info-alert message="Never share this code with anyone. Gravitest will never ask for your 2FA code via phone or email." type="security"}}

  {{> action-button buttonText="Login to Account" buttonUrl=loginUrl}}

{{/layouts/base}}