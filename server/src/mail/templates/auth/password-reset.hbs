{{#> layouts/base title="Reset your password" subject="Password reset request — Gravitest"}}

  <p style="font-size: 15px; color: #444444; line-height: 1.7; margin: 0 0 8px;">
    We received a request to reset the password for your Gravitest account.
  </p>
  <p style="font-size: 14px; color: #888888; line-height: 1.7; margin: 0 0 4px;">
    Use the code below to create a new password.
  </p>

  {{> otp-card otpCode=otpCode expiryMinutes=expiryMinutes}}

  {{> action-button buttonText="Reset password" buttonUrl=resetUrl}}

  {{> info-alert message="If you did not request a password reset, no action is needed. Your current password remains unchanged." type="warning"}}

{{/layouts/base}}
