{{#> layouts/base title="Reset Your Password" subject="Reset Your Password - Gravitas"}}
  
  <p style="font-size: 15px; color: #4b5563; line-height: 1.6; margin: 0 0 16px;">
    We received a request to reset your Gravitas account password. Use the code below to create a new password.
  </p>

  {{> otp-card otpCode=otpCode expiryMinutes=expiryMinutes}}

  {{#if infoMessage}}
    {{> info-alert message="If you didn't request this reset, please ignore this email. Your password will remain unchanged." type="warning"}}
  {{/if}}

  {{> action-button buttonText="Reset Password" buttonUrl=resetUrl}}

{{/layouts/base}}