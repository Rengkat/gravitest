<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <title>{{subject}}</title>
  <style>
    /* CLIENT-SAFE RESET */
    body, table, td, p, a {
      margin: 0;
      padding: 0;
      border: 0;
      font-size: 100%;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      line-height: 1.5;
    }
    body {
      background-color: #f0fdf4;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    table {
      border-collapse: collapse;
      mso-table-lspace: 0;
      mso-table-rspace: 0;
    }
    img {
      border: 0;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
      -ms-interpolation-mode: bicubic;
    }
    /* OUTLOOK 2013+ */
    .ExternalClass, .ReadMsgBody {
      width: 100%;
      background-color: #f0fdf4;
    }
    .ExternalClass, .ExternalClass p, .ExternalClass span, .ExternalClass font, .ExternalClass td, .ExternalClass div {
      line-height: 100%;
    }
    /* RESPONSIVE */
    @media only screen and (max-width: 600px) {
      .container {
        width: 100% !important;
      }
      .mobile-stack {
        display: block !important;
        width: 100% !important;
        text-align: center !important;
      }
      .mobile-padding {
        padding-left: 20px !important;
        padding-right: 20px !important;
      }
      .button-mobile {
        display: inline-block !important;
        width: auto !important;
      }
      .otp-code {
        font-size: 32px !important;
        letter-spacing: 8px !important;
      }
    }
    /* DARK MODE SUPPORT */
    @media (prefers-color-scheme: dark) {
      .dark-bg {
        background-color: #1a1a1a !important;
      }
      .dark-text {
        color: #e5e5e5 !important;
      }
      .dark-card {
        background-color: #2d2d2d !important;
        border-color: #404040 !important;
      }
    }
  </style>
</head>
<body style="background-color: #f0fdf4; margin: 0; padding: 0;">
  <center style="width: 100%; table-layout: fixed;">
    <table align="center" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; width: 100%; background-color: #f0fdf4;" role="presentation">
      <tr>
        <td align="center" style="padding: 20px 0;">
          
          <!-- MAIN CONTAINER -->
          <table class="container" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px; width: 100%; background-color: #ffffff; border-radius: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); overflow: hidden;">
            <tr>
              <td style="padding: 0;">
                
                <!-- HEADER PARTIAL -->
                {{> header}}
                
                <!-- CONTENT AREA -->
                <table width="100%" cellpadding="0" cellspacing="0" style="padding: 32px 32px 24px;">
                  <tr>
                    <td style="padding: 0;">
                      
                      <!-- GREETING BLOCK -->
                      {{> greeting firstName=firstName}}
                      
                      <!-- MAIN CONTENT (INJECTED) -->
                      {{{body}}}
                      
                      <!-- INFO ALERT BLOCK (OPTIONAL) -->
                      {{#if infoMessage}}
                        {{> info-alert message=infoMessage type=infoType}}
                      {{/if}}
                      
                    </td>
                  </tr>
                </table>
                
                <!-- FOOTER PARTIALS -->
                {{> footer}}
                
              </td>
            </tr>
          </table>
          
          <!-- FOOTER BRANDING -->
          <table width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px; margin-top: 24px;">
            <tr>
              <td align="center" style="padding: 16px 20px;">
                <p style="font-size: 12px; color: #9ca3af; margin: 0;">&copy; {{year}} Gravitest. All rights reserved.</p>
                <p style="font-size: 11px; color: #d1d5db; margin: 8px 0 0;">
                  Building Nigeria's brightest futures.
                </p>
                <div style="margin-top: 12px;">
                  <a href="https://gravitest.ng/privacy" style="font-size: 11px; color: #9ca3af; text-decoration: none; margin: 0 8px;">Privacy</a>
                  <span style="font-size: 11px; color: #d1d5db;">•</span>
                  <a href="https://gravitest.ng/terms" style="font-size: 11px; color: #9ca3af; text-decoration: none; margin: 0 8px;">Terms</a>
                  <span style="font-size: 11px; color: #d1d5db;">•</span>
                  <a href="https://gravitest.ng/help" style="font-size: 11px; color: #9ca3af; text-decoration: none; margin: 0 8px;">Help</a>
                </div>
              </td>
            </tr>
          </table>
          
        </td>
      </tr>
    </table>
  </center>
</body>
</html>