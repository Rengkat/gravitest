<table width="100%" cellpadding="0" cellspacing="0" style="margin: 24px 0;">
  <tr>
    <td align="center">
      <a
        href="{{buttonUrl}}"
        style="display: inline-block; background: linear-gradient(135deg, #16a34a 0%, #15803d 100%); color: #ffffff; font-size: 14px; font-weight: 600; text-decoration: none; padding: 12px 32px; border-radius: 50px; box-shadow: 0 2px 8px rgba(22,163,74,0.3);"
      >
        {{buttonText}}
      </a>
    </td>
  </tr>
</table>