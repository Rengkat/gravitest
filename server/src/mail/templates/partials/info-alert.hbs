<!-- INFO ALERT -->
{{#if (eq type 'warning')}}
  <table
    width='100%'
    cellpadding='0'
    cellspacing='0'
    role='presentation'
    style='border-left: 3px solid #c8922a; background-color: #fdf8f0; border-radius: 0 4px 4px 0; margin: 20px 0;'
  >
    <tr>
      <td style='padding: 14px 18px;'>
        <p
          style='font-size: 13px; color: #5a3e0a; margin: 0; line-height: 1.6;'
        >{{message}}</p>
      </td>
    </tr>
  </table>
{{else if (eq type 'error')}}
  <table
    width='100%'
    cellpadding='0'
    cellspacing='0'
    role='presentation'
    style='border-left: 3px solid #b03030; background-color: #fdf4f4; border-radius: 0 4px 4px 0; margin: 20px 0;'
  >
    <tr>
      <td style='padding: 14px 18px;'>
        <p
          style='font-size: 13px; color: #6b1e1e; margin: 0; line-height: 1.6;'
        >{{message}}</p>
      </td>
    </tr>
  </table>
{{else if (eq type 'success')}}
  <table
    width='100%'
    cellpadding='0'
    cellspacing='0'
    role='presentation'
    style='border-left: 3px solid #1a4a2e; background-color: #f2f7f4; border-radius: 0 4px 4px 0; margin: 20px 0;'
  >
    <tr>
      <td style='padding: 14px 18px;'>
        <p
          style='font-size: 13px; color: #0d2b1a; margin: 0; line-height: 1.6;'
        >{{message}}</p>
      </td>
    </tr>
  </table>
{{else if (eq type 'security')}}
  <table
    width='100%'
    cellpadding='0'
    cellspacing='0'
    role='presentation'
    style='border-left: 3px solid #b03030; background-color: #fdf4f4; border-radius: 0 4px 4px 0; margin: 20px 0;'
  >
    <tr>
      <td style='padding: 14px 18px;'>
        <p
          style='font-size: 13px; color: #6b1e1e; margin: 0; line-height: 1.6;'
        >{{message}}</p>
      </td>
    </tr>
  </table>
{{else}}
  <table
    width='100%'
    cellpadding='0'
    cellspacing='0'
    role='presentation'
    style='border-left: 3px solid #4a7fab; background-color: #f4f8fd; border-radius: 0 4px 4px 0; margin: 20px 0;'
  >
    <tr>
      <td style='padding: 14px 18px;'>
        <p
          style='font-size: 13px; color: #1a3a5c; margin: 0; line-height: 1.6;'
        >{{message}}</p>
      </td>
    </tr>
  </table>
{{/if}}