<table width="100%" cellpadding="0" cellspacing="0" style="background-color: {{#if (eq type 'warning')}}#fefce8{{else if (eq type 'error')}}#fef2f2{{else if (eq type 'success')}}#f0fdf4{{else}}#eff6ff{{/if}}; border-left: 4px solid {{#if (eq type 'warning')}}#eab308{{else if (eq type 'error')}}#dc2626{{else if (eq type 'success')}}#16a34a{{else}}#3b82f6{{/if}}; border-radius: 12px; margin: 20px 0;">
  <tr>
    <td style="padding: 14px 18px;">
      <div style="display: flex; align-items: flex-start; gap: 10px;">
        {{#if (eq type 'warning')}}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
          <path d="M12 8v4M12 16h.01"/>
          <path d="M12 2L2 7l10 5 10-5-10-5z"/>
          <path d="M2 17l10 5 10-5"/>
          <path d="M2 12l10 5 10-5"/>
        </svg>
        {{else if (eq type 'error')}}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        {{else if (eq type 'success')}}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
          <path d="M20 6L9 17l-5-5"/>
        </svg>
        {{else}}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        {{/if}}
        <p style="font-size: 13px; color: #374151; margin: 0;">{{message}}</p>
      </div>
     </td>
   </tr>
</table>