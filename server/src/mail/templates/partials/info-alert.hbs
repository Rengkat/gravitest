<!-- INFO ALERT -->
{{#if (eq type 'warning')}}
  <table
    width='100%'
    cellpadding='0'
    cellspacing='0'
    role='presentation'
    style='border-left: 3px solid #e5a000; background-color: #fffbf0; border-radius: 0 4px 4px 0; margin: 24px 0;'
  >
    <tr>
      <td style='padding: 14px 18px;'>
        <p style='font-size: 13px; color: #7a5500; margin: 0; line-height: 1.6;'>{{message}}</p>
      </td>
    </tr>
  </table>
{{else if (eq type 'error')}}
  <table
    width='100%'
    cellpadding='0'
    cellspacing='0'
    role='presentation'
    style='border-left: 3px solid #d93025; background-color: #fff8f8; border-radius: 0 4px 4px 0; margin: 24px 0;'
  >
    <tr>
      <td style='padding: 14px 18px;'>
        <p style='font-size: 13px; color: #8b1a1a; margin: 0; line-height: 1.6;'>{{message}}</p>
      </td>
    </tr>
  </table>
{{else if (eq type 'success')}}
  <table
    width='100%'
    cellpadding='0'
    cellspacing='0'
    role='presentation'
    style='border-left: 3px solid #1a7a3c; background-color: #f4fbf6; border-radius: 0 4px 4px 0; margin: 24px 0;'
  >
    <tr>
      <td style='padding: 14px 18px;'>
        <p style='font-size: 13px; color: #0d4a22; margin: 0; line-height: 1.6;'>{{message}}</p>
      </td>
    </tr>
  </table>
{{else if (eq type 'security')}}
  <table
    width='100%'
    cellpadding='0'
    cellspacing='0'
    role='presentation'
    style='border-left: 3px solid #d93025; background-color: #fff8f8; border-radius: 0 4px 4px 0; margin: 24px 0;'
  >
    <tr>
      <td style='padding: 14px 18px;'>
        <p style='font-size: 13px; color: #8b1a1a; margin: 0; line-height: 1.6;'>{{message}}</p>
      </td>
    </tr>
  </table>
{{else}}
  <table
    width='100%'
    cellpadding='0'
    cellspacing='0'
    role='presentation'
    style='border-left: 3px solid #4285f4; background-color: #f8fbff; border-radius: 0 4px 4px 0; margin: 24px 0;'
  >
    <tr>
      <td style='padding: 14px 18px;'>
        <p style='font-size: 13px; color: #1a3a6b; margin: 0; line-height: 1.6;'>{{message}}</p>
      </td>
    </tr>
  </table>
{{/if}}
