<!-- OTP CARD -->
<table
  width='100%'
  cellpadding='0'
  cellspacing='0'
  role='presentation'
  style='border: 1px solid #e5e5e5; border-radius: 6px; margin: 24px 0;'
>
  <tr>
    <td style='padding: 20px 24px;'>
      <p
        style='font-size: 11px; font-weight: 600; color: #999999; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 10px;'
      >Verification Code</p>

      <table cellpadding='0' cellspacing='0' role='presentation'>
        <tr>
          <td
            style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; font-size: 22px; font-weight: 700; color: #111111; letter-spacing: 6px; white-space: nowrap; line-height: 1;"
          >{{otpCode}}</td>
        </tr>
      </table>

      <p style='font-size: 12px; color: #999999; margin: 10px 0 0; line-height: 1.5;'>
        Expires in <strong style='color: #555555; font-weight: 600;'>{{expiryMinutes}} minutes.</strong> Do not share it with anyone.
      </p>
    </td>
  </tr>
</table>
