<!-- OTP CARD -->
<table
  width='100%'
  cellpadding='0'
  cellspacing='0'
  role='presentation'
  style='background-color: #f7f6f2; border: 1px solid #e0ddd6; border-radius: 4px; margin: 24px 0;'
>
  <tr>
    <td style='padding: 28px 32px;'>
      <p
        style='font-size: 11px; font-weight: 600; color: #9e9b94; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 14px;'
      >
        Verification Code
      </p>
      <p
        class='otp-code'
        style="font-family: 'Courier New', Courier, monospace; font-size: 36px; font-weight: 700; letter-spacing: 10px; color: #0d2b1a; margin: 0 0 16px; line-height: 1;"
      >
        {{otpCode}}
      </p>
      <p style='font-size: 13px; color: #6b6861; margin: 0; line-height: 1.5;'>
        This code expires in
        <strong style='color: #0d2b1a;'>{{expiryMinutes}} minutes.</strong>
        Do not share it with anyone.
      </p>
    </td>
  </tr>
</table>