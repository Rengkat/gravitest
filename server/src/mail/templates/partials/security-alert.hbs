<!-- SECURITY ALERT -->
<table
  width='100%'
  cellpadding='0'
  cellspacing='0'
  role='presentation'
  style='border-left: 3px solid #d93025; background-color: #fff8f8; border-radius: 0 4px 4px 0; margin: 24px 0;'
>
  <tr>
    <td style='padding: 18px 20px;'>
      <p
        style='font-size: 11px; font-weight: 600; color: #d93025; letter-spacing: 0.1em; text-transform: uppercase; margin: 0 0 12px;'
      >
        Security Notice
      </p>
      <p
        style='font-size: 13px; color: #8b1a1a; margin: 0 0 14px; line-height: 1.6;'
      >{{alertMessage}}</p>
      <table
        cellpadding='0'
        cellspacing='0'
        role='presentation'
        style='width: 100%;'
      >
        {{#if deviceName}}
          <tr>
            <td style='font-size: 12px; color: #aaaaaa; padding: 3px 0; width: 80px; vertical-align: top;'>Device</td>
            <td style='font-size: 12px; color: #333333; padding: 3px 0; font-weight: 500;'>{{deviceName}}</td>
          </tr>
        {{/if}}
        {{#if browser}}
          <tr>
            <td style='font-size: 12px; color: #aaaaaa; padding: 3px 0; width: 80px; vertical-align: top;'>Browser</td>
            <td style='font-size: 12px; color: #333333; padding: 3px 0; font-weight: 500;'>{{browser}}</td>
          </tr>
        {{/if}}
        {{#if ipAddress}}
          <tr>
            <td style='font-size: 12px; color: #aaaaaa; padding: 3px 0; width: 80px; vertical-align: top;'>IP Address</td>
            <td style='font-size: 12px; color: #333333; padding: 3px 0; font-weight: 500;'>{{ipAddress}}</td>
          </tr>
        {{/if}}
        {{#if time}}
          <tr>
            <td style='font-size: 12px; color: #aaaaaa; padding: 3px 0; width: 80px; vertical-align: top;'>Time</td>
            <td style='font-size: 12px; color: #333333; padding: 3px 0; font-weight: 500;'>{{time}}</td>
          </tr>
        {{/if}}
        {{#if location}}
          <tr>
            <td style='font-size: 12px; color: #aaaaaa; padding: 3px 0; width: 80px; vertical-align: top;'>Location</td>
            <td style='font-size: 12px; color: #333333; padding: 3px 0; font-weight: 500;'>{{location}}</td>
          </tr>
        {{/if}}
      </table>
    </td>
  </tr>
</table>
