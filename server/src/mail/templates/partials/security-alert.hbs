<!-- SECURITY ALERT -->
<table
  width='100%'
  cellpadding='0'
  cellspacing='0'
  role='presentation'
  style='border-left: 3px solid #b03030; background-color: #fdf4f4; border-radius: 0 4px 4px 0; margin: 20px 0;'
>
  <tr>
    <td style='padding: 16px 18px;'>
      <p
        style='font-size: 11px; font-weight: 600; color: #b03030; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px;'
      >
        Security Notice
      </p>
      <p
        style='font-size: 13px; color: #6b1e1e; margin: 0 0 14px; line-height: 1.6;'
      >{{alertMessage}}</p>
      <table
        cellpadding='0'
        cellspacing='0'
        role='presentation'
        style='width: 100%;'
      >
        {{#if deviceName}}
          <tr>
            <td
              style='font-size: 12px; color: #9e9b94; padding: 4px 0; width: 90px; vertical-align: top;'
            >Device</td>
            <td
              style='font-size: 12px; color: #2c2a26; padding: 4px 0; font-weight: 500;'
            >{{deviceName}}</td>
          </tr>
        {{/if}}
        {{#if browser}}
          <tr>
            <td
              style='font-size: 12px; color: #9e9b94; padding: 4px 0; width: 90px; vertical-align: top;'
            >Browser</td>
            <td
              style='font-size: 12px; color: #2c2a26; padding: 4px 0; font-weight: 500;'
            >{{browser}}</td>
          </tr>
        {{/if}}
        {{#if ipAddress}}
          <tr>
            <td
              style='font-size: 12px; color: #9e9b94; padding: 4px 0; width: 90px; vertical-align: top;'
            >IP Address</td>
            <td
              style='font-size: 12px; color: #2c2a26; padding: 4px 0; font-weight: 500;'
            >{{ipAddress}}</td>
          </tr>
        {{/if}}
        {{#if time}}
          <tr>
            <td
              style='font-size: 12px; color: #9e9b94; padding: 4px 0; width: 90px; vertical-align: top;'
            >Time</td>
            <td
              style='font-size: 12px; color: #2c2a26; padding: 4px 0; font-weight: 500;'
            >{{time}}</td>
          </tr>
        {{/if}}
        {{#if location}}
          <tr>
            <td
              style='font-size: 12px; color: #9e9b94; padding: 4px 0; width: 90px; vertical-align: top;'
            >Location</td>
            <td
              style='font-size: 12px; color: #2c2a26; padding: 4px 0; font-weight: 500;'
            >{{location}}</td>
          </tr>
        {{/if}}
      </table>
    </td>
  </tr>
</table>