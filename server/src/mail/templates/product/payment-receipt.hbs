{{#> layouts/base title="Payment Receipt" subject="Your Payment Receipt - Gravitest"}}
  
  <p style="font-size: 15px; color: #4b5563; line-height: 1.6; margin: 0 0 16px;">
    Thank you for your payment! Here's your receipt.
  </p>

  <div style="background-color: #f9fafb; border-radius: 16px; padding: 20px; margin: 20px 0;">
    <p style="font-size: 12px; color: #6b7280; margin: 0 0 12px;">Payment Details</p>
    <p style="font-size: 14px; margin: 8px 0;"><strong>Description:</strong> {{description}}</p>
    <p style="font-size: 14px; margin: 8px 0;"><strong>Amount:</strong> ₦{{amount}}</p>
    <p style="font-size: 14px; margin: 8px 0;"><strong>Date:</strong> {{date}}</p>
    <p style="font-size: 14px; margin: 8px 0;"><strong>Reference:</strong> {{reference}}</p>
    <p style="font-size: 14px; margin: 8px 0;"><strong>Payment Method:</strong> {{paymentMethod}}</p>
  </div>

  <div style="margin-top: 20px;">
    {{> action-button buttonText="Download Receipt (PDF)" buttonUrl=invoiceUrl}}
  </div>

{{/layouts/base}}