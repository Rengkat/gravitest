{{#> layouts/base title="Upcoming Session Reminder" subject="Reminder: Your Tutoring Session Tomorrow - Gravitas"}}
  
  <p style="font-size: 15px; color: #4b5563; line-height: 1.6; margin: 0 0 16px;">
    This is a reminder about your upcoming tutoring session.
  </p>

  <div style="background-color: #eff6ff; border-radius: 16px; padding: 20px; margin: 20px 0;">
    <p style="font-size: 14px; font-weight: 600; color: #1e40af; margin: 0 0 12px;">📅 Session Details</p>
    <p style="font-size: 14px; margin: 6px 0;"><strong>Subject:</strong> {{subject}}</p>
    <p style="font-size: 14px; margin: 6px 0;"><strong>Tutor:</strong> {{tutorName}}</p>
    <p style="font-size: 14px; margin: 6px 0;"><strong>Date & Time:</strong> {{date}} at {{time}}</p>
    <p style="font-size: 14px; margin: 6px 0;"><strong>Duration:</strong> {{duration}} hour(s)</p>
    
    {{#if meetingLink}}
      <div style="margin-top: 16px;">
        {{> action-button buttonText="Join Session" buttonUrl=meetingLink}}
      </div>
    {{/if}}
  </div>

  <p style="font-size: 12px; color: #6b7280; margin: 16px 0 0;">
    Please log in 5 minutes before the session starts.
  </p>

{{/layouts/base}}