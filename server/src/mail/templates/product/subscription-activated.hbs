{{#> layouts/base title="Subscription activated" subject="Your Gravitest subscription is now active"}}

  <p style="font-size: 15px; color: #444444; line-height: 1.7; margin: 0 0 8px;">
    Your subscription is active. You now have full access to all premium features on Gravitest.
  </p>

  <table width="100%" cellpadding="0" cellspacing="0" role="presentation"
    style="background-color: #f2f7f4; border: 1px solid #c8ddd0; border-radius: 4px; margin: 24px 0 28px;">
    <tr>
      <td style="padding: 20px 24px;">
        <p style="font-size: 11px; font-weight: 600; color: #5a7a67; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 14px;">
          Subscription summary
        </p>
        <table cellpadding="0" cellspacing="0" role="presentation" style="width: 100%;">
          <tr>
            <td style="font-size: 12px; color: #5a7a67; padding: 5px 0; width: 130px; vertical-align: top;">Plan</td>
            <td style="font-size: 13px; color: #111111; padding: 5px 0; font-weight: 600;">{{planName}}</td>
          </tr>
          <tr>
            <td style="font-size: 12px; color: #5a7a67; padding: 5px 0; width: 130px; vertical-align: top;">Billing cycle</td>
            <td style="font-size: 13px; color: #111111; padding: 5px 0; font-weight: 500;">{{billingCycle}}</td>
          </tr>
          <tr>
            <td style="font-size: 12px; color: #5a7a67; padding: 5px 0; width: 130px; vertical-align: top;">Amount</td>
            <td style="font-size: 13px; color: #111111; padding: 5px 0; font-weight: 600;">&#8358;{{amount}} / {{billingCycle}}</td>
          </tr>
          <tr>
            <td style="font-size: 12px; color: #5a7a67; padding: 5px 0; width: 130px; vertical-align: top;">Next billing date</td>
            <td style="font-size: 13px; color: #111111; padding: 5px 0; font-weight: 500;">{{nextBillingDate}}</td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  {{> action-button buttonText="Start learning" buttonUrl=dashboardUrl}}

{{/layouts/base}}
